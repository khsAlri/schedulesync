# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 않습니다.

# 세션 쿠키 서명용 비밀 값 (필수). 길고 무작위한 문자열을 넣으세요.
# 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# DB 접속 주소. 기본은 프로젝트 폴더의 SQLite 파일입니다.
DATABASE_URL=sqlite:///./schedulesync.db

# 슬랙 Bot Token (6단계 슬랙 DM 알림에서 사용). 비워 두면 슬랙 발송을 건너뜁니다.
SLACK_BOT_TOKEN=

# 알림 메시지에 넣을 웹페이지 주소
APP_BASE_URL=http://localhost:8000
